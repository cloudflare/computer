    "triage": {
      "source": "tasks/triage/TASK.md",
      "bundleHash": "0f8a7a5d18486d304d7952d16c7d3599658d2e5d105daca8ee83aea5c54eff47",
      "workflow": ".github/workflows/gardener-triage.yml",
      "bundle": {
        "schemaVersion": "gardener.task-bundle/v1",
        "taskId": "triage",
        "name": "Triage",
        "description": "Summarises new issues, points out likely duplicates, and applies existing labels.",
        "instructions": "Triage the issue that triggered this run.\n\n1. Use the provider API to list the repository's labels (`GET /repos/{owner}/{repo}/labels`) and to\n   search for similar open issues (`GET /search/issues` with `q=repo:{owner}/{repo} is:issue\n   is:open` plus two or three key words from the title).\n2. Read repository files only if the issue is about specific code.\n3. Propose `issue.comment.create`: at most 80 words, summarising the problem and the likely area of\n   the code. If any open issue looks like a duplicate, link it. Do not promise a fix.\n4. Propose `issue.label.add` for at most two labels that already exist and clearly fit. Skip this\n   step if none fit; never invent a label.\n\nThen finish.",
        "triggers": [
          {
            "kind": "github.issue.opened",
            "labelsAll": [],
            "mentions": [],
            "authors": "maintainers"
          },
          {
            "kind": "github.workflow_dispatch"
          }
        ],
        "tools": [
          "repository.list_files",
          "repository.read_file",
          "provider.api.read"
        ],
        "effects": [
          "issue.label.add",
          "issue.comment.create"
        ],
        "network": {
          "default": "deny",
          "allow": [],
          "deny": []
        },
        "limits": {
          "runtimeSeconds": 300,
          "maxTurns": 12,
          "maxToolCalls": 16,
          "inputTokens": 80000,
          "outputTokens": 16000
        },
        "model": "@cf/zai-org/glm-5.3"
      },
      "deployment": {
        "schemaVersion": "gardener.github-actions-task-plan/v1",
        "target": "github-actions/v1",
        "taskId": "triage",
        "planningPermissions": {
          "checks": "read",
          "contents": "read",
          "discussions": "read",
          "id-token": "write",
          "issues": "read",
          "pull-requests": "read",
          "statuses": "read"
        },
        "effectsPermissions": {
