{
  "name": "@example/computer-remote-exec",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Example Worker whose CodemodeBackend runs commands in a container through @cloudflare/computer/remote-exec's codemode:exec, with workspace files synced in and out.",
  "scripts": {
    "fetch:remote-exec": "scripts/fetch-remote-exec.sh",
    "predev": "scripts/fetch-remote-exec.sh",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "build:types": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/computer": "*"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.148.0"
  }
}
