// Worker + Durable Object hosting a Cloudflare Container that runs
// the wsd daemon. The TriageAgent DO extends @cloudflare/think and
// owns one Workspace per agent name; the TriageWorkflow drives a
// three-step pipeline against it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "think-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-26",
  "compatibility_flags": ["nodejs_compat"],

  "ai": { "binding": "AI" },

  // Cloudflare Artifacts binding. Commented out so the demo runs
  // without an Artifacts namespace by default. Uncomment this
  // stanza and re-run `wrangler types` to enable
  // TriageAgent.listArtifacts() and the session-scoped artifacts
  // client in src/agent.ts. Every repo the agent creates is scoped
  // under its DO id. See docs/14_artifacts_interface.md.
  // "artifacts": [{ "binding": "ARTIFACTS", "namespace": "default" }],

  // Worker Loader binding. The TriageAgent's Workspace mounts a
  // worker backend (just-bash in a Dynamic Worker) alongside the
  // container backend; the worker backend dials through env.LOADER.
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],

  "containers": [
    {
      "class_name": "TriageAgent",
      "image": "./Dockerfile",
      "max_instances": 5
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "TriageAgent", "class_name": "TriageAgent" }]
  },

  // R2 bucket mounted into every Workspace at /workspace/.agents.
  // Seed it with `npm run seed:r2 --workspace @cloudflare/example-think`
  // which uploads ./seed/r2-skills/.agents/skills/triage/SKILL.md to
  // the bucket under the `.agents/` prefix.
  // No `preview_bucket_name`: `wrangler dev` and `wrangler deploy`
  // both bind to `think-example-skills`, so the seed scripts only
  // have one bucket to populate. See examples/container for the
  // same shape and the reasoning.
  "r2_buckets": [
    {
      "binding": "R2_SKILLS",
      "bucket_name": "think-example-skills"
    },
    // Bucket the `share` tool uploads to. The presigner also needs
    // R2 S3 credentials, set as secrets: R2_ACCESS_KEY_ID,
    // R2_SECRET_ACCESS_KEY, and CLOUDFLARE_ACCOUNT_ID. Without
    // them the agent runs fine but the `share` tool is omitted.
    {
      "binding": "ASSETS",
      "bucket_name": "think-example-assets"
    }
  ],

  "workflows": [
    {
      "name": "TRIAGE_WORKFLOW",
      "binding": "TRIAGE_WORKFLOW",
      "class_name": "TriageWorkflow"
    }
  ],

  "vars": {
    "R2_ENDPOINT": "",
    "R2_ACCESS_KEY_ID": "",
    "R2_SECRET_ACCESS_KEY": "",
    "CLOUDFLARE_ACCOUNT_ID": ""
  },

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TriageAgent"] }]
}
