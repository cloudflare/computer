{
  "name": "@cloudflare/example-think",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Minimal @cloudflare/think chat agent backed by a @cloudflare/computer VFS. Talk to it from a terminal with the AI SDK v7 TUI.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "chat": "node ./cli/chat.mjs",
    "typecheck": "tsc --noEmit",
    "build:types": "wrangler types"
  },
  "bin": {
    "think-chat": "./cli/chat.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.45",
    "@ai-sdk/tui": "^1.0.43",
    "@cloudflare/computer": "*",
    "@cloudflare/think": "^0.21.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@platformatic/vfs": "^0.4.0",
    "agents": "^0.29.0",
    "ai": "^7.0.0",
    "isomorphic-git": "^1.38.3",
    "just-bash": "^3.0.1",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "wrangler": "^4.148.0"
  }
}
