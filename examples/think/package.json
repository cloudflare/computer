{
  "name": "@cloudflare/example-think",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Minimal @cloudflare/think chat agent backed by a @cloudflare/computer VFS. Talk to it from a terminal with the AI SDK v7 TUI.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "chat": "node ./cli/chat.mjs",
    "typecheck": "tsc --noEmit"
  },
  "bin": {
    "think-chat": "./cli/chat.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.45",
    "@ai-sdk/tui": "^1.0.43",
    "@cloudflare/computer": "*",
    "@cloudflare/think": "^0.15.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@platformatic/vfs": "^0.4.0",
    "agents": "^0.20.0",
    "ai": "^7.0.0",
    "isomorphic-git": "^1.38.3",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260616.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.107.1"
  }
}
