{
  "name": "@example/computer-container",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Example Worker + Durable Object that uses @cloudflare/computer inside a Cloudflare Container.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "seed:r2": "wrangler r2 object put computer-container-hello/hello.txt --file ./seed/data/hello.txt --remote",
    "seed:r2:local": "wrangler r2 object put computer-container-hello/hello.txt --file ./seed/data/hello.txt --local",
    "build:types": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/computer": "*"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "wrangler": "^4.130.0"
  }
}
