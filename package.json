{
  "name": "@cloudflare/computer",
  "private": true,
  "packageManager": "npm",
  "workspaces": [
    "packages/dofs",
    "packages/rpc",
    "packages/computer",
    "packages/computerd",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:bin": "npm run build:bin --workspaces --if-present",
    "build:docker": "npm run build:docker --workspaces --if-present",
    "build:all": "npm run build && npm run build:bin && npm run build:docker",
    "format": "biome format --write .",
    "check": "biome check . && biome format . && sherif --fail-on-warnings",
    "check:fix": "biome check . --fix && sherif --fix --select highest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.1",
    "pkg-pr-new": "^0.0.75",
    "postject": "^1.0.0-alpha.6",
    "sherif": "^1.11.1",
    "typescript": "^6.0.3"
  }
}
