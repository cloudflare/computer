{
  "name": "@cloudflare/workspace",
  "private": true,
  "workspaces": [
    "packages/dofs",
    "packages/rpc",
    "packages/workspace",
    "packages/wsd",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:bin": "npm run build:bin --workspaces --if-present",
    "build:docker": "npm run build:docker --workspaces --if-present",
    "build:all": "npm run build && npm run build:bin && npm run build:docker",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.1",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^6.0.3"
  }
}
