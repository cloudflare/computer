{
  "name": "@cloudflare/computer",
  "private": true,
  "packageManager": "npm",
  "workspaces": [
    "packages/dofs",
    "packages/rpc",
    "packages/computer",
    "packages/computerd",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:bin": "npm run build:bin --workspaces --if-present",
    "build:docker": "npm run build:docker --workspaces --if-present",
    "build:all": "npm run build && npm run build:bin && npm run build:docker",
    "build:types": "npm run build:types --workspaces --if-present",
    "postinstall": "npm run build:types",
    "format": "oxfmt",
    "lint": "oxlint",
    "check": "oxlint && oxfmt --check && sherif --fail-on-warnings",
    "check:fix": "oxlint --fix && oxfmt && sherif --fix --select highest",
    "changeset": "changeset",
    "gardener:generate": "npx --yes @scuffi/gardener@0.1.13 generate"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.31.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "pkg-pr-new": "^0.0.75",
    "postject": "^1.0.0-alpha.6",
    "sherif": "^1.11.1",
    "typescript": "^6.0.3"
  }
}
