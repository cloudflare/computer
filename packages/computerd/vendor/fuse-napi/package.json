{
  "name": "fuse-napi",
  "version": "2.3.1",
  "description": "Production-grade Node-API bindings for FUSE 3 on Linux and macOS",
  "keywords": [
    "fuse",
    "filesystem",
    "napi",
    "native-addon",
    "linux",
    "macos",
    "macfuse"
  ],
  "main": "index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "files": [
    "CHANGELOG.md",
    "COMPATIBILITY.md",
    "CONTRIBUTING.md",
    "README.md",
    "RELEASING.md",
    "SECURITY.md",
    "UPSTREAM.md",
    "binding.gyp",
    "fuse-native.c",
    "index.d.ts",
    "index.js",
    "lib/fuse3-options.js",
    "lib/environment.js",
    "lib/macfuse.js",
    "lib/native-binding.js",
    "prebuilds/",
    "scripts/fuse-config.js",
    "scripts/verify-release.js"
  ],
  "gypfile": true,
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "dependencies": {
    "nanoresource": "^1.3.0",
    "napi-macros": "^2.2.2",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "concat-stream": "^2.0.0",
    "node-gyp": "^13.0.1",
    "prebuildify": "^6.0.1",
    "tape": "^5.10.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmdevries/fuse-napi.git"
  },
  "author": "Matthijs de Vries",
  "contributors": [
    {
      "name": "Mathias Buus",
      "url": "https://github.com/mafintosh"
    },
    {
      "name": "SageMath, Inc."
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mmdevries/fuse-napi/issues"
  },
  "homepage": "https://github.com/mmdevries/fuse-napi#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node --check index.js && node --check example.js && node --check lib/environment.js && node --check lib/fuse3-options.js && node --check lib/macfuse.js && node --check lib/native-binding.js && node --check scripts/fuse-config.js && node --check scripts/modern-operations-smoke.js && node --check scripts/mount-soak.js && node --check scripts/open-release-soak.js && node --check scripts/package-mount-smoke.js && node --check scripts/verify-release.js && node --check scripts/write-leak-soak.js && node --check test/fixtures/modern-operations-runner.js && node --check test/invalidation.js && node --check test/modern-operations.js && node --check test/option-fuzz.js && node --check test/privileged/broken-mount.js",
    "install": "node-gyp-build",
    "test": "tape test/*.js",
    "test:package-mount": "node scripts/package-mount-smoke.js",
    "test:fuzz": "node test/option-fuzz.js",
    "test:privileged-recovery": "tape test/privileged/broken-mount.js",
    "test:soak": "node --expose-gc scripts/mount-soak.js",
    "test:open-release": "node --expose-gc scripts/open-release-soak.js",
    "test:write-leak": "node --expose-gc scripts/write-leak-soak.js",
    "test:unit": "tape test/dependencies.js test/environment.js test/errno.js test/hardening.js test/mount-ready.js test/options.js test/release.js",
    "test:types": "tsc -p tsconfig.json",
    "clean": "rm -rf node_modules build",
    "prebuild": "prebuildify --strip --no-napi --node-gyp node_modules/.bin/node-gyp",
    "verify:metadata": "node scripts/verify-release.js",
    "verify:release": "node scripts/verify-release.js --artifacts",
    "prepublishOnly": "node scripts/verify-release.js --artifacts"
  }
}
