{
  "name": "@cloudflare/computerd",
  "version": "0.2.1",
  "description": "Computer daemon CLI, FUSE mount, and the in-container codemode CLI. Source-only; the distributables live at @cloudflare/computer-computerd-linux-x64.",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "bin": {
    "codemode": "./dist/cli/codemode.cjs",
    "computerd": "./dist/cli/computerd.cjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "build:bin": "node ./scripts/build-bin.mjs",
    "build:docker": "node ./scripts/build-docker.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "publish:docker": "node ./scripts/build-docker.mjs --push"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@cloudflare/computer-rpc": "*",
    "@cloudflare/dofs": "*",
    "@platformatic/vfs": "^0.4.0",
    "capnweb": "^0.10.0",
    "fuse-native": "^2.2.6",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
