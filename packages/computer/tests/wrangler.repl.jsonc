// Config for durable REPL session tests (vitest.config.repl.ts).
{
  "name": "repl-tests",
  "main": "./repl-worker.ts",
  "compatibility_date": "2026-06-23",
  "compatibility_flags": ["nodejs_compat", "experimental"],
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": {
    "bindings": [{ "name": "HOST", "class_name": "ReplHostDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReplHostDO"] }]
}
