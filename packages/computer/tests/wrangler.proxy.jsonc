{
  // Test-only worker for the WorkspaceProxy unit tests. Not deployed.
  // Mounts the real WorkspaceProxy entrypoint via ctx.exports and a
  // TestStorageDO that answers /ws with a marker so we can verify
  // routing landed.
  "name": "computer-proxy-tests",
  "main": "./proxy-worker.ts",
  "compatibility_date": "2026-05-26",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "COMPUTERD",
        "class_name": "TestStorageDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TestStorageDO"]
    }
  ]
}
